{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Misorter List v1",
  "$comment": "Input must be UTF-8 and at most 1048576 bytes. The canonical two-space-indented JSON encoding with a trailing newline must also be at most 1048576 UTF-8 bytes. These byte constraints require application validation. Array order is input order, not ranking. Duplicate values are preserved.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "title", "items"],
  "properties": {
    "format": { "const": "misorter-list" },
    "version": { "const": 1 },
    "title": { "$ref": "#/definitions/title" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value"],
        "properties": { "value": { "$ref": "#/definitions/value" } }
      }
    }
  },
  "definitions": {
    "title": {
      "type": "string",
      "maxLength": 255,
      "allOf": [{ "pattern": "\\S" }, { "not": { "pattern": "\u0000" } }]
    },
    "value": {
      "type": "string",
      "maxLength": 2000,
      "allOf": [{ "pattern": "\\S" }, { "not": { "pattern": "\u0000" } }]
    }
  }
}
