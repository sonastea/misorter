# Vite environment variables (must be prefixed with VITE_)
# Optional - for production deployments (Cloudflare Workers, custom domain, etc.)
# If not set, will use relative URLs (API on same domain)

# Frontend environment variables
VITE_API_URL="https://api.your-domain.com"

# Twitch OAuth client ID (public; used in the browser authorize URL)
VITE_CLIENT_ID=""

#! Supabase (auth) - required by both frontend and backend
VITE_SUPABASE_URL=""
VITE_SUPABASE_KEY=""

# Backend environment variables
DATABASE_URL=""

# Twitch OAuth (server-only; the Worker exchanges auth codes, so the secret
# must NOT use a VITE_ prefix. TWITCH_CLIENT_ID mirrors VITE_CLIENT_ID.)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

RESEND_API_KEY=""
SUPPORT_FROM_EMAIL=""
SUPPORT_TO_EMAIL=""
