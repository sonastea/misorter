{
  "name": "misorter",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n worker,vite -c blue,green \"bun run dev:worker\" \"bun run dev:client\"",
    "dev:client": "vite",
    "dev:worker": "wrangler dev",
    "dev:pages": "wrangler pages dev",
    "build": "vite build",
    "build:worker": "wrangler deploy --dry-run",
    "build:pages": "bun build",
    "deploy:worker": "wrangler deploy",
    "deploy:worker:preview": "wrangler deploy --env preview",
    "deploy:pages": "bun run build:pages && wrangler pages deploy dist --branch production",
    "deploy:pages:preview": "bun run build:pages && wrangler pages deploy dist --branch preview",
    "deploy": "bun run deploy:worker && bun run deploy:pages",
    "deploy:preview": "bun run deploy:worker:preview && bun run deploy:pages:preview",
    "preview": "vite preview",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@headlessui/tailwindcss": "^0.2.2",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/router-devtools": "^1.167.1",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "@upstash/ratelimit": "^2.0.8",
    "drizzle-orm": "^1.0.0-rc.4",
    "html-to-image": "^1.11.13",
    "nanoid": "^6.0.1",
    "postgres": "^3.4.9",
    "resend": "^6.26.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.35",
    "@trpc/server": "^11.18.0",
    "@types/bun": "^1.4.1",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  }
}
